BOT_TOKEN=
# Числовой ID владельца. Получите его командой /id после запуска бота.
SUPERADMIN_IDS=
DATABASE_PATH=data/bot.sqlite3
TIMEZONE=Europe/Moscow
# Пилот ограничен факультетом Форсайт.
ALLOWED_FACULTY=Специальный факультет талантливой молодежи "Форсайт" (высшая школа)
SCHEDULE_TTL_SECONDS=1800
CATALOG_TTL_SECONDS=86400
REA_REQUEST_INTERVAL_SECONDS=8


# Час ежедневного обновления текущей и следующей недели (TIMEZONE).
SCHEDULE_REFRESH_HOUR=7
